/*
 * Common RK3566 DSM/NAS support.
 *
 * Keep display, HDMI audio and board-only connectors out of this file.
 */

#include "rk3566.dtsi"
#include <dt-bindings/input/rk-input.h>

/ {
	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <1750>;
		};

		vol-down-key {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <297500>;
		};
	};

	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/delete-node/ drm-logo@00000000;
		/delete-node/ drm-cubic-lut@00000000;

		rknpu_reserved: rknpu {
			compatible = "shared-dma-pool";
			inactive;
			reusable;
			size = <0x0 0x20000000>;
			alignment = <0x0 0x1000>;
			status = "disabled";
		};
	};

	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_12v>;
	};

	vcc_1v8: vcc_1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_3v3: vcc_3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_fixed: vdd-fixed {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed";
		regulator-min-microvolt = <950000>;
		regulator-max-microvolt = <950000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_cpu: vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <&pwm0 0 5000 1>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1200000>;
		regulator-init-microvolt = <950000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		regulator-ramp-delay = <2300>;
		pwm-supply = <&vcc5v0_sys>;
		status = "okay";
	};

	vdd_logic: vdd-logic {
		compatible = "pwm-regulator";
		pwms = <&pwm1 0 5000 1>;
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1100000>;
		regulator-init-microvolt = <950000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		regulator-ramp-delay = <6001>;
		pwm-supply = <&vcc5v0_sys>;
		status = "okay";
	};
};

&bus_npu {
	status = "disabled";
};

&cpu0 {
	clocks = <&cru ARMCLK>;
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	clocks = <&cru ARMCLK>;
};

&cpu2 {
	clocks = <&cru ARMCLK>;
};

&cpu3 {
	clocks = <&cru ARMCLK>;
};

&cpu0_opp_table {
	/* Restore Rockchip SoC-version and speed-grade filtering.
	 * The J/M alternatives are inherited from rk3568.dtsi; do not delete
	 * them or a special bin can lose all of its valid frequency points.
	 */
	rockchip,supported-hw;
	/delete-node/ opp-1992000000;

	/*
	 * P0.5: 1800 MHz is a bad bin on this board.
	 *
	 * Verified on hardware: with >=2 cores under load the box hard-hangs
	 * at a peak of only 56 C, far below every thermal trip.  Reproduced
	 * with two different supplies, so it is not thermal and not a PSU
	 * fault.  The 1608 MHz cap used to be enforced only by the uInitrd
	 * hook writing scaling_max_freq; if that hook ever stops running
	 * (firmware upgrade, path change, initrd rebuild) the kernel would
	 * happily pick 1800 MHz again and hang the box.
	 *
	 * Deleting the OPP makes 1608 MHz a kernel level limit: cpufreq no
	 * longer exposes 1800 MHz at all, so the hook becomes a redundant
	 * belt-and-braces measure rather than the only guard.
	 *
	 * With hardware filtering restored, the normal/M table has six OPPs,
	 * while the J table has only 1008/1416 MHz.  Cooling maps therefore
	 * specify frequency ceilings, resolved against the actual CPUFreq
	 * table when binding, rather than assuming one state index layout.
	 */
	/delete-node/ opp-1800000000;

	opp-408000000 {
		opp-supported-hw = <0xfb 0xffff>;
		opp-hz = /bits/ 64 <408000000>;
		opp-microvolt = <850000 850000 1200000>;
	};

	opp-600000000 {
		opp-supported-hw = <0xfb 0xffff>;
		opp-hz = /bits/ 64 <600000000>;
		opp-microvolt = <850000 850000 1200000>;
	};

	opp-816000000 {
		opp-supported-hw = <0xfb 0xffff>;
		opp-hz = /bits/ 64 <816000000>;
		opp-microvolt = <850000 850000 1200000>;
	};

	opp-1104000000 {
		opp-supported-hw = <0xfb 0xffff>;
		opp-hz = /bits/ 64 <1104000000>;
		opp-microvolt = <900000 900000 1200000>;
	};

	opp-1416000000 {
		opp-supported-hw = <0xfb 0xffff>;
		opp-hz = /bits/ 64 <1416000000>;
		opp-microvolt = <1025000 1025000 1200000>;
	};

	opp-1608000000 {
		opp-supported-hw = <0xf9 0xffff>;
		opp-hz = /bits/ 64 <1608000000>;
		opp-microvolt = <1100000 1100000 1200000>;
	};

	/*
	 * P0: make the board level opp-microvolt above actually apply.
	 *
	 * rockchip_set_opp_prop_name() derives "opp-microvolt-L<n>" from the
	 * chip leakage/PVTM bin, and opp/of.c looks that property up FIRST,
	 * falling back to plain "opp-microvolt" only when it is absent.
	 * The SoC dtsi still carries the inherited per-bin voltages, so on
	 * every L1/L2/L3 part the board values above were bypassed.
	 * Measured on this unit (pvtm-volt-sel=1): 1608 MHz ran at 1050 mV
	 * instead of 1100 mV, 1416 MHz at 975 mV instead of 1025 mV, i.e.
	 * a uniform -50 mV gap.  vdd_cpu is a pwm-regulator, so that head
	 * room is not free.  Drop the inherited per-bin voltages so the
	 * values written above are the ones actually applied.
	 *
	 * opp-1800000000 is not touched here: it is deleted entirely above,
	 * so it must not be redefined below.
	 */
	opp-1104000000 {
		/delete-property/ opp-microvolt-L0;
		/delete-property/ opp-microvolt-L1;
		/delete-property/ opp-microvolt-L2;
		/delete-property/ opp-microvolt-L3;
	};

	opp-1416000000 {
		/delete-property/ opp-microvolt-L0;
		/delete-property/ opp-microvolt-L1;
		/delete-property/ opp-microvolt-L2;
		/delete-property/ opp-microvolt-L3;
	};

	opp-1608000000 {
		/delete-property/ opp-microvolt-L0;
		/delete-property/ opp-microvolt-L1;
		/delete-property/ opp-microvolt-L2;
		/delete-property/ opp-microvolt-L3;
	};
};

&dfi {
	status = "okay";
};

&dmc {
	auto-freq-en = <0>;
	center-supply = <&vdd_fixed>;
	status = "okay";
};

&gpu {
	clocks = <&cru CLK_GPU>;
	clock-names = "clk_mali";
	mali-supply = <&vdd_fixed>;
	status = "okay";
};

&gpu_opp_table {
	/delete-node/ opp-700000000;
	/delete-node/ opp-800000000;
	/delete-node/ opp-j-600000000;
	/delete-node/ opp-m-800000000;

	opp-200000000 {
		/delete-property/ opp-supported-hw;
		opp-hz = /bits/ 64 <200000000>;
		opp-microvolt = <850000 850000 1000000>;
	};

	opp-300000000 {
		/delete-property/ opp-supported-hw;
		opp-hz = /bits/ 64 <300000000>;
		opp-microvolt = <850000 850000 1000000>;
	};

	opp-400000000 {
		/delete-property/ opp-supported-hw;
		opp-hz = /bits/ 64 <400000000>;
		opp-microvolt = <850000 850000 1000000>;
	};

	opp-500000000 {
		opp-hz = /bits/ 64 <500000000>;
		opp-microvolt = <900000 900000 1000000>;
	};

	opp-600000000 {
		/delete-property/ opp-supported-hw;
		opp-hz = /bits/ 64 <600000000>;
		opp-microvolt = <900000 900000 1000000>;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-names = "active";
};

&pwm1 {
	status = "okay";
	pinctrl-names = "active";
};

&rk_rga {
	clock-names = "aclk", "hclk", "sclk";
	resets = <&cru SRST_RGA_CORE>, <&cru SRST_A_RGA>, <&cru SRST_H_RGA>;
	reset-names = "core", "axi", "ahb";
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&rkvenc {
	dynamic-power-coefficient = <200>;
	venc-supply = <&vdd_logic>;
	status = "okay";

	power-model {
		compatible = "simple-power-model";
		thermal-zone = "soc-thermal";
		static-coefficient = <100000>;
		dynamic-coefficient = <200>;
		ts = <32000 4700 (-80) 2>;
		ref-leakage = <50>;
	};
};

&rkvenc_mmu {
	status = "okay";
};

&rkvdec {
	dynamic-power-coefficient = <200>;
	resets = <&cru SRST_A_RKVDEC_NIU>, <&cru SRST_H_RKVDEC_NIU>,
		 <&cru SRST_A_RKVDEC>, <&cru SRST_H_RKVDEC>,
		 <&cru SRST_RKVDEC_CA>, <&cru SRST_RKVDEC_CORE>,
		 <&cru SRST_RKVDEC_HEVC_CA>;
	reset-names = "niu_a", "niu_h", "video_a", "video_h",
		      "video_cabac", "video_core", "video_hevc_cabac";
	vdec-supply = <&vdd_logic>;
	status = "okay";

	power-model {
		compatible = "simple-power-model";
		thermal-zone = "soc-thermal";
		static-coefficient = <100000>;
		dynamic-coefficient = <200>;
		ts = <32000 4700 (-80) 2>;
		ref-leakage = <50>;
	};
};

&rkvdec_mmu {
	status = "okay";
};

&rknpu {
	clocks = <&cru CLK_NPU>, <&cru ACLK_NPU>, <&cru HCLK_NPU>;
	clock-names = "clk", "aclk", "hclk";
	dynamic-power-coefficient = <250>;
	memory-region = <&rknpu_reserved>;
	rknpu-supply = <&vdd_fixed>;
	status = "okay";

	power-model {
		compatible = "simple-power-model";
		thermal-zone = "soc-thermal";
		static-coefficient = <100000>;
		dynamic-coefficient = <250>;
		ts = <32000 4700 (-80) 2>;
		ref-leakage = <4>;
	};
};

&rknpu_mmu {
	status = "okay";
};

/*
 * Deliberately no #cooling-cells on the NPU.
 *
 * Giving the node #cooling-cells would let a cooling-map reference it, but
 * that does not make thermal management work: the NPU frequency is static
 * (the rknpu_ondemand governor does not sample load) and it already sits at
 * 600 MHz on a fixed 950 mV rail, so "throttling" it either does nothing or
 * risks an under-voltage operating point the OPP table never described.
 *
 * Its high-temperature protection is a userspace task gate in the
 * RK3566_NPU_Server package instead - see the cooling-maps comment above.
 */

/*
 * Thermal policy for the RK3566 OEC BOX (DS124).
 *
 * The board is passively cooled: no fan, and the SoC reaches its limit
 * long before the stock 85 C trip.  Verified on hardware: a >=2 core load
 * at 1800 MHz hard-hangs the box at a peak of 56 C, i.e. well below both
 * the 75 C and the 85 C trip, so the stock trips are useless as a
 * protection.  The SoC dtsi also ships a 75 C "threshold" trip that no
 * cooling-map ever referenced, so it was a dead entry.
 *
 * Three explicit frequency ceilings, resolved against the hardware-filtered
 * CPUFreq table at cooling-map binding time:
 *
 *   50 C  request at most 1416 MHz
 *   55 C  request at most  816 MHz
 *   75 C  request at most  408 MHz
 *
 * Normal/M bins have six OPPs and resolve these to states 1/3/5.  The J
 * alternatives provide only 1008/1416 MHz, so they resolve to states 0/1/1.
 * For J, 1008 MHz is the documented fallback at 55/75 C, NOT 816/408 MHz.
 *
 * The 50/55 C thresholds were chosen after a real NPU + simulated CPU
 * image-decode load reached 57.2 C; they are not proof of the cause of
 * lockups or white-LED boot failures reported on other boards.
 *
 * rockchip,cpu-frequency-ceiling-khz overrides the lower cooling-state
 * bound using the runtime table.  The first cooling-device argument is
 * only a zero placeholder; the upper bound stays THERMAL_NO_LIMIT so
 * step_wise can continue down to the lowest frequency the bin supports.
 * The standard cooling-map ABI is unchanged for maps without this property.
 *
 * The GPU keeps its own map1 on the same 75 C trip and its own cooling
 * device (thermal-devfreq-*), so the CPU state numbers above do not drag
 * the GPU down.
 *
 * NOTE: node overrides merge by PATH, not by label, so the trips below
 * reuse the SoC dtsi node names (trip-point-0/1) on purpose.  Writing
 * "threshold { ... }" here would create a *sibling* node named
 * "threshold" instead of changing trip-point-0.
 */
&soc_thermal {
	trips {
		/* was 75000 and bound to nothing - a dead trip.
		 * 50000 (50 C): measured real concurrent load (face+concept) peaks
		 * at 57.2 C while 60 C was never reached, so the old 60 C first step
		 * never engaged.  Hysteresis 2000 inherited -> resumes at 48 C, which
		 * keeps the 48.3 C single-task concept run from thrashing.
		 */
		trip-point-0 {
			temperature = <50000>;
		};

		/* was 85000; the box hard-hangs well before 85 C */
		trip-point-1 {
			temperature = <75000>;
		};

		/* intermediate step. 68 C was also unreachable (peak 57.2 C);
		 * 55 C sits 5 C above the first step and within the concurrent peak.
		 */
		cpu_mid: trip-point-2 {
			temperature = <55000>;
			hysteresis = <2000>;
			type = "passive";
		};
	};

	cooling-maps {
		/*
		 * map0 and map1 come from rk3568.dtsi and both point at the
		 * 85 C "target" trip: map0 -> CPU, map1 -> GPU.  map0 is
		 * tightened to the 75 C ceiling; map1 is left untouched so
		 * the GPU keeps its own behaviour.
		 *
		 * Each cooling-device reference is <&dev MAXSTATE THERMAL_NO_LIMIT>:
		 * MAXSTATE is the fastest frequency the tier may allow, and the
		 * unlimited second argument lets the governor drop all the way
		 * to the lowest OPP when the temperature keeps rising.
		 */
		map0 {
			trip = <&target>;
			cooling-device = <&cpu0 0 THERMAL_NO_LIMIT>;
			rockchip,cpu-frequency-ceiling-khz = <408000>;
			contribution = <1024>;
		};

		/* 55 C: the CPU may not run faster than 816 MHz */
		map2 {
			trip = <&cpu_mid>;
			cooling-device = <&cpu0 0 THERMAL_NO_LIMIT>;
			rockchip,cpu-frequency-ceiling-khz = <816000>;
			contribution = <1024>;
		};

		/* 50 C: the CPU may not run faster than 1416 MHz */
		map3 {
			trip = <&threshold>;
			cooling-device = <&cpu0 0 THERMAL_NO_LIMIT>;
			rockchip,cpu-frequency-ceiling-khz = <1416000>;
			contribution = <1024>;
		};

		/*
		 * The NPU is deliberately NOT bound here.
		 *
		 * Throttling it through a cooling-map does not work on this
		 * board, for two independent reasons:
		 *
		 *  1. the NPU has no load-driven frequency scaling.  The
		 *     rknpu_ondemand governor's get_dev_status() returns
		 *     nothing and get_target_freq() just echoes ondemand_freq,
		 *     which is set once at probe to the current clock and only
		 *     changed by a debugfs write.  The frequency is static.
		 *
		 *  2. the static frequency it sits at is already 600 MHz, which
		 *     is also the LOWEST state this table could meaningfully
		 *     ask for without going below the boot frequency.  Any
		 *     cooling step that lands on 600 MHz changes nothing.
		 *
		 * On top of that the NPU rail is vdd_fixed, a fixed 950 mV
		 * regulator, so lowering the clock would not lower the voltage
		 * either - the thermal benefit is a fraction of the CPU's.
		 *
		 * High-temperature protection for the NPU therefore lives in
		 * userspace: the RK3566_NPU_Server package pauses acceptance of
		 * new recognition jobs at 55 C and resumes at 53 C, finishing
		 * the photo already in flight first.  See
		 * npufix-spk/src/payload/npulib/rknn_server/npu_server_rknn.py.
		 */
	};
};

&npu_opp_table {
	/delete-property/ rockchip,supported-hw;
	/delete-node/ opp-1000000000;
	/delete-node/ opp-j-600000000;
	/delete-node/ opp-m-900000000;

	opp-200000000 {
		/delete-property/ opp-supported-hw;
	};

	opp-300000000 {
		/delete-property/ opp-supported-hw;
	};

	opp-400000000 {
		/delete-property/ opp-supported-hw;
	};

	opp-600000000 {
		/delete-property/ opp-supported-hw;
	};

	opp-700000000 {
		/delete-property/ opp-supported-hw;
	};

	opp-800000000 {
		/delete-property/ opp-supported-hw;
	};

	opp-900000000 {
		/delete-property/ opp-supported-hw;
	};
};

&rockchip_suspend {
	status = "okay";
	rockchip,sleep-mode-config = <
		(0
		| RKPM_SLP_CENTER_OFF
		| RKPM_SLP_HW_PLLS_OFF
		| RKPM_SLP_PMUALIVE_32K
		| RKPM_SLP_PMIC_LP
		| RKPM_SLP_32K_PVTM
		)
	>;
	rockchip,wakeup-config = <
		(0
		| RKPM_PWM0_WKUP_EN
		| RKPM_CPU0_WKUP_EN
		)
	>;
};

&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&sdhci {
	/* Compatibility experiment: avoid the HS200/HS400 DLL/tuning path. */
	max-frequency = <52000000>;
	/delete-property/ mmc-hs200-1_8v;
	/delete-property/ mmc-hs200-1_2v;
	/delete-property/ mmc-hs400-1_8v;
	/delete-property/ mmc-hs400-1_2v;
	/delete-property/ mmc-hs400-enhanced-strobe;
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd
		     &emmc_datastrobe &emmc_rstnout>;
	status = "okay";
};

&sfc {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&tsadc {
	status = "okay";
};

&u2phy0_host {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usbdrd30 {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "otg";
	phys = <&u2phy0_otg>;
	maximum-speed = "high-speed";
	extcon = <&usb2phy0>;
	snps,dev_force_20_clk_for_30_clk;
	status = "okay";
};

&usbhost30 {
	status = "okay";
};

&usbhost_dwc3 {
	status = "okay";
};
